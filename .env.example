# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo server: usata dal job degli invii programmati.
SUPABASE_SERVICE_ROLE_KEY=

# Assistente AI. Con ANTHROPIC_API_KEY si chiama direttamente Anthropic.
# Su Vercel la chiave è facoltativa: senza, si passa da Vercel AI Gateway.
ANTHROPIC_API_KEY=
# Facoltativo: modello da usare per le bozze.
# AI_MODEL=claude-opus-5-5

# Chiave per cifrare i segreti dei provider email: openssl rand -base64 32
EMAIL_SECRETS_KEY=

# Segreto del job /api/cron/send-scheduled: openssl rand -hex 32
CRON_SECRET=

# URL pubblico dell'app, usato nei link di conferma dell'account.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
